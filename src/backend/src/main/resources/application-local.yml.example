# 本地配置示例
# 使用方式：
#   1. 复制本文件为同目录下的 application-local.yml
#   2. 填写真实的数据库密码
#   3. 启动时指定 profile：java -jar ecommerce-backend.jar --spring.profiles.active=local
#      或在 IDE 的 VM 参数中加入 -Dspring.profiles.active=local
# 注意：application-local.yml 已被 .gitignore 排除，不会被提交到仓库。
spring:
  datasource:
    username: root
    password: 请填写你的数据库密码
