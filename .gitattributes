* text=auto

# 源码与文档统一使用 LF，避免跨平台 diff 噪音
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.sql    text eol=lf
*.js     text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.html   text eol=lf

# Windows 脚本保持 CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做换行符转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.docx   binary
*.jar    binary
